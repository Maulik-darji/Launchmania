rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only maulik.darji2005@gmail.com, signed in with Google, can read.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'maulik.darji2005@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function str(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    match /waitlist/{id} {
      // Anyone can join, but only with the expected fields and sizes.
      allow create: if request.resource.data.keys().hasOnly([
            'email', 'name', 'productUrl', 'productType', 'stage', 'audience',
            'willingToPay', 'source', 'referrer', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time
        && str('name', 100) && str('productUrl', 300) && str('productType', 60)
        && str('stage', 60) && str('audience', 20) && str('willingToPay', 20)
        && str('source', 30) && str('referrer', 500);

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
